{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "No Spoiler GTA6",
  "description": "__MSG_extDescription__",
  "version": "1.0.1",
  "default_locale": "en",
  "homepage_url": "https://github.com/TomasCorreiaa/gta6-no-spoiler",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "__MSG_extName__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://m.youtube.com/*",
    "*://*.twitch.tv/*",
    "*://x.com/*",
    "*://*.x.com/*",
    "*://twitter.com/*",
    "*://*.twitter.com/*",
    "*://www.facebook.com/*",
    "*://m.facebook.com/*",
    "*://web.facebook.com/*",
    "*://www.instagram.com/*",
    "*://web.whatsapp.com/*",
    "*://www.tiktok.com/*",
    "*://*.tiktok.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://*.twitch.tv/*",
        "*://x.com/*",
        "*://*.x.com/*",
        "*://twitter.com/*",
        "*://*.twitter.com/*",
        "*://www.facebook.com/*",
        "*://m.facebook.com/*",
        "*://web.facebook.com/*",
        "*://www.instagram.com/*",
        "*://web.whatsapp.com/*",
        "*://www.tiktok.com/*",
        "*://*.tiktok.com/*"
      ],
      "js": [
        "src/shared/settings.js",
        "src/content/selectors.js",
        "src/content/filter.js",
        "src/content/content.js"
      ],
      "css": ["src/content/content.css"],
      "run_at": "document_start"
    }
  ]
}

